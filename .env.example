# Supabase project credentials (leave unset to run in local dev-mode with seed data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Unsplash Access Key (leave unset to keep the fixed stock photos already
# baked into each page). Get a free one at https://unsplash.com/developers —
# create an app, copy its "Access Key". With it set, marketing-page hero
# photos rotate to a fresh live Unsplash photo roughly weekly (see
# src/lib/unsplash.ts). VITE_UNSPLASH_APP_NAME should match the app name you
# registered with Unsplash (used only for the required UTM attribution
# links) — defaults to "perfect10ant" if unset.
VITE_UNSPLASH_ACCESS_KEY=
VITE_UNSPLASH_APP_NAME=

# Stripe is NOT configured via this file — it's wired up server-side as
# Supabase Edge Function secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# STRIPE_PRICE_STARTER/GROWTH/PORTFOLIO, PUBLIC_SITE_URL). See
# docs/ARCHITECTURE.md and supabase/functions/stripe-checkout/index.ts.
